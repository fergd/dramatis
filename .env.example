# Copy this file to .env and fill in your own values. Nothing here is
# committed to git (.env is gitignored).

# Required - portrait storage. Get the URL from your Cloudinary dashboard
# ("API Environment variable", looks like
# cloudinary://<key>:<secret>@<cloud_name>).
CLOUDINARY_URL=

# Optional - enables automatic Google Drive backup of the database. Without
# these, the app works fully; backup/restore just stay unavailable and
# /status shows drive_configured: false. Create an OAuth 2.0 "Desktop app"
# client at https://console.cloud.google.com/apis/credentials (enable the
# Drive API on the project first). See README.md for the one-time
# authorization step (drive_backup.py --authorize) that produces token.json.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional - override where the SQLite DB and OAuth token live. Defaults to
# ./profiles.db and ./token.json in the working directory.
# PROFILES_DB_PATH=profiles.db
# GOOGLE_TOKEN_PATH=token.json

# Required - who's allowed to log in, comma-separated. Each person gets their
# own characters, fields, and tags, invisible to everyone else. This is NOT
# a security boundary (there's no password) - it only separates each
# person's data. Real access control is up to you (e.g. Tailscale).
DRAMATIS_USERS=

# Optional - who pre-existing data (from before this app had logins) belongs
# to. Used once, by an automatic one-time migration. Defaults to the first
# name in DRAMATIS_USERS.
# DRAMATIS_LEGACY_OWNER=

# Optional - enables document import (upload a dossier, Claude extracts
# characters/fields/relationships into a reviewable preview). Same key/
# pattern as zamak-ledger. Get a key at https://console.anthropic.com/.
# Without this, the app works fully; import just stays unavailable and
# /status shows import_configured: false.
ANTHROPIC_API_KEY=
